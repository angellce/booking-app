# Backend environment variables. The defaults in application.properties match docker-compose.yml,
# so none of these are needed locally. Set them in your hosting provider (e.g. Render) for production.
# Locally you can copy this file to backend/.env (git-ignored); Spring Boot loads it on startup.

# JDBC URL, e.g. for Neon/Supabase: jdbc:postgresql://<host>:5432/<db>?sslmode=require
DB_URL=jdbc:postgresql://localhost:5433/booking
DB_USERNAME=booking
DB_PASSWORD=booking

# Comma-separated list of frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# HTTP port (Render sets this automatically)
PORT=8080

# Optional: Gemini API key from https://aistudio.google.com/apikey (free tier) for AI confirmation messages.
# Leave empty to use the built-in template message.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Google Calendar clash check. Calendar ID (often your Gmail address) and the path to the service
# account JSON key (keep it outside the repository; on Render use a Secret File, e.g. /etc/secrets/google-sa.json).
# Share the calendar with the service account email as "See only free/busy (hide details)".
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=
